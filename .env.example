APP_NAME=Medical AI Hospital System API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=20
DATABASE_URL=postgresql+psycopg://medical:medical_dev_only@localhost:5432/medical_ai
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Central Medical AI defaults: disabled until each capability is approved and runtimes are validated.
AI_OPERATING_MODE=hybrid
AI_ENABLED_CAPABILITIES=[]
AI_ALLOW_HOSTED=false
AI_REQUESTS_ENABLED=false
AI_LOCAL_MODEL_ENABLED=false

# Local OpenAI-compatible runtime (disabled by default; provision and validate separately).
AI_LOCAL_MODEL_ENABLED=false
AI_LOCAL_MODEL_BASE_URL=http://ollama:11434
AI_LOCAL_MODEL_NAME=
AI_LOCAL_MODEL_VERSION=unverified
AI_LOCAL_MODEL_DIGEST=
AI_LOCAL_MODEL_API_KEY=
AI_LOCAL_MODEL_TIMEOUT_SECONDS=45
AI_LOCAL_MODEL_MAX_TOKENS=1200
AI_LOCAL_MODEL_ALLOWED_HOSTS=["localhost","127.0.0.1","::1","ollama"]
